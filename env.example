# Required: your Deepgram API key. Nimrod holds this server-side so clients never see it.
DEEPGRAM_API_KEY=

# WebSocket port Nimrod listens on
PORT=8550

# Deepgram options
DEEPGRAM_MODEL=nova-3
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
SOURCE_LANGUAGE_CODE_LOCALE=en-US

# Audio format clients must send: raw PCM, 16-bit signed little-endian, mono
SAMPLE_RATE=16000
CHUNK_DURATION_MS=20

# Session tuning
FINALIZE_TIMEOUT_MS=5000       # Max wait for a final transcript after END_OF_AUDIO
BUFFER_MAX_CHUNKS=1000         # Audio chunks buffered per client before backpressure
KEEP_ALIVE_INTERVAL_MS=5000    # Keep-alive ping interval to Deepgram
DG_CONNECT_MAX_RETRIES=3       # Deepgram connection retry attempts
DG_CONNECT_BASE_DELAY_MS=1000  # Base delay for exponential backoff between retries

# ---------------------------------------------------------------------------
# Client authentication (optional). Leave unset to accept any connection,
# which is the behaviour of earlier versions. See README "Authentication".
# ---------------------------------------------------------------------------

# none   - no authentication (default)
# static - clients must present AUTH_STATIC_KEY
# token  - clients must present a short-lived HS256 JWT signed with AUTH_TOKEN_SECRET
AUTH_MODE=none

# Shared secret for AUTH_MODE=static
AUTH_STATIC_KEY=

# HMAC secret for AUTH_MODE=token. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_SECRET=

# Reject tokens whose lifetime (exp - iat) exceeds this many seconds. 0 disables.
AUTH_TOKEN_MAX_TTL_SEC=3600

# Comma-separated browser Origins allowed to connect. Empty = not checked.
# Requests without an Origin header (non-browser clients) always pass this check.
AUTH_ALLOWED_ORIGINS=

# Set to true only when Nimrod is behind a reverse proxy you control; the first
# X-Forwarded-For entry is then used as the client IP for MAX_CONNECTIONS_PER_IP.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Usage caps (optional). 0 = unlimited. Apply regardless of AUTH_MODE.
# Mid-connection limits close the WebSocket with code 1008 and a reason string.
# ---------------------------------------------------------------------------

MAX_CONNECTION_SEC=0            # Close a connection after this many seconds
MAX_AUDIO_SEC_PER_CONNECTION=0  # Close after this many seconds of audio have been received
MAX_CONNECTIONS_PER_IP=0        # Concurrent connections allowed per client IP
MAX_CONNECTIONS_PER_SUBJECT=0   # Concurrent connections per token "sub" (AUTH_MODE=token only)
